{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "djc",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // The free plan supports only SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Per client IP, per Cloudflare location; the period must be 10 or 60 seconds.
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "4201", "simple": { "limit": 10, "period": 60 } },
    { "name": "CONNECT_LIMIT", "namespace_id": "4202", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
